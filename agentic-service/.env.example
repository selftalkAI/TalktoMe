# Agentic Service configuration — the Agentic Layer (ADD §7 / TDD §20).
# Copy this file to .env and edit as needed. .env is gitignored — never commit real AWS credentials.

# Which provider the gateway calls: "ollama" (local, free, no cloud dependency)
# or "bedrock" (AWS, required for Bedrock Agents / production).
MODEL_PROVIDER=ollama

# --- Ollama (local) ---
# Install: brew install ollama && ollama serve
# Pull a model once:  ollama pull llama3.1
# Pull an embedding model once: ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Optional per-step routing (ADD ADR-023). Both default to OLLAMA_MODEL.
# LARGE serves Brain 2's Speak/Decide and Brain 1's core agents; SMALL serves cheap steps.
# OLLAMA_MODEL_LARGE=llama3.1
# OLLAMA_MODEL_SMALL=llama3.1

# --- AWS Bedrock ---
# Credentials are NOT set here — use `aws configure` / standard AWS env vars
# (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY) or an IAM role. Bedrock model access
# must be enabled per-model in the AWS console before first use.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# BEDROCK_MODEL_ID_LARGE=
# BEDROCK_MODEL_ID_SMALL=

# Shared
MODEL_TIMEOUT_SECONDS=60
