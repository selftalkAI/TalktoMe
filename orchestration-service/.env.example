# Orchestration Service configuration (API layer + data layer).
# Copy to .env and edit as needed. .env is gitignored.

# Where the Agentic Service is reachable. Orchestration never talks to
# Ollama/Bedrock directly — it always goes through this service.
AGENTIC_SERVICE_URL=http://localhost:8001
AGENTIC_REQUEST_TIMEOUT_SECONDS=60

# Comma-separated list of origins allowed to call this API (the Observability Portal).
CORS_ALLOW_ORIGINS=http://localhost:3000
